{
  "name": "mini-camp-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "微缩营地巡游 - 网页端三渲二房车营地微缩小玩具",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
